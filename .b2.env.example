# Backblaze B2 S3 credentials (do not commit the real .b2.env file).
# You can also use AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY instead.
ASTERIA_B2_KEY_ID=replace-with-key-id
ASTERIA_B2_APPLICATION_KEY=replace-with-application-key

# Optional overrides.
ASTERIA_B2_BUCKET=asteria-firmware-images
ASTERIA_B2_ENDPOINT=s3.eu-central-003.backblazeb2.com
